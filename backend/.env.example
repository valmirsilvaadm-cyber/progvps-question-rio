# Credenciais de e-mail (Gmail) usadas para ENVIAR o orçamento.
# Voce precisa ativar a verificacao em 2 etapas na conta do Gmail
# e gerar uma "Senha de app" em https://myaccount.google.com/apppasswords
# NAO use a senha normal da conta, use a senha de app gerada.
SMTP_USER=seu-email-remetente@gmail.com
SMTP_PASS=sua-senha-de-app-de-16-digitos

# Para onde o orcamento sera enviado (equipe prog.vps)
TO_EMAIL=prog.vps@gmail.com

# Porta do servidor backend
PORT=4000
